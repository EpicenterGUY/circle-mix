{
  "version": "0.9.51",
  "build": {
    "frontendDist": "../android-dist",
    "beforeDevCommand": "npm run android:prepare",
    "beforeBuildCommand": "npm run android:check"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CIRCLE MIX",
        "width": 1280,
        "height": 720,
        "minWidth": 360,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "fullscreen": true,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.github.com"
    }
  },
  "bundle": {
    "targets": "all",
    "icon": [
      "app-icon.svg"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 9051
    }
  }
}
